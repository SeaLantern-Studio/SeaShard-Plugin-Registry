{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://seashard.org/schemas/plugin-registration-v1.schema.json",
  "title": "SeaShard plugin registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "summary", "owners", "source", "license", "releases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository"],
      "properties": {
        "type": { "const": "github" },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,99})/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,99})$"
        }
      }
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "tag", "asset", "archiveSha256"],
        "properties": {
          "version": { "type": "string", "minLength": 1, "maxLength": 80 },
          "tag": { "type": "string", "minLength": 1, "maxLength": 100 },
          "asset": {
            "type": "string",
            "pattern": "^[^/\\\\\\u0000]+\\.seashard-plugin$",
            "maxLength": 240
          },
          "archiveSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "yanked": { "type": "boolean" }
        }
      }
    }
  }
}
